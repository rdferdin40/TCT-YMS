# TCT-YMS Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME="TCT Yard Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tct_yms
DB_USERNAME=yms_user
DB_PASSWORD=

# Session Configuration
SESSION_LIFETIME=120
SESSION_SECURE=true

# Mail Configuration (for password reset)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# File Upload Settings
UPLOAD_MAX_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,csv,xlsx

# Timezone
APP_TIMEZONE=America/Chicago

# Logging
LOG_LEVEL=warning
LOG_FILE=storage/logs/app.log

# Feature Flags (1=enabled, 0=disabled)
FEATURE_DARK_MODE=1
FEATURE_CSV_IMPORT=1
FEATURE_CSV_EXPORT=1
FEATURE_PHOTO_UPLOAD=1
